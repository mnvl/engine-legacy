#! /bin/sh

build_type=Debug

for i in $*;
do
    case $i in
	--debug)
	    build_type=Debug
	    ;;

	--release)
	    build_type=Release
	    ;;

	--relug)
	    build_type=RelWithDebInfo
	    ;;

	--help)
	    echo "$0 (--debug|--release|--relug)" >/dev/stderr
	    exit 1
	    ;;

	*)
	    echo "invalid argument $i" >/dev/stderr
	    exit 1
	    ;;
    esac
done

cmake -G "Unix Makefiles" -DCMAKE_BUILD_TYPE=$build_type ../
