                <extra>
                  <technique profile="MayaNextGen">
                    <blend_mode>NONE</blend_mode>
                    <coverageU>1</coverageU>
                    <coverageV>1</coverageV>
                    <fast>0</fast>
                    <mirrorU>0</mirrorU>
                    <mirrorV>0</mirrorV>
                    <noiseU>0</noiseU>
                    <noiseV>0</noiseV>
                    <offsetU>0</offsetU>
                    <offsetV>0</offsetV>
                    <repeatU>1</repeatU>
                    <repeatV>1</repeatV>
                    <rotateFrame>0</rotateFrame>
                    <rotateUV>0</rotateUV>
                    <stagger>0</stagger>
                    <translateFrameU>0</translateFrameU>
                    <translateFrameV>0</translateFrameV>
                    <wrapU>1</wrapU>
                    <wrapV>1</wrapV>
                  </technique>
                </extra>
              </texture>
            </diffuse>
            <transparent opaque="RGB_ZERO">
              <color>0 0 0 1</color>
            </transparent>
            <transparency>
              <float>1</float>
            </transparency>
          </lambert>
        </technique>
      </profile_COMMON>
      <extra>
        <technique profile="MayaNextGen">
          <originalMayaNodeId>lambert1</originalMayaNodeId>
        </technique>
      </extra>
    </effect>
