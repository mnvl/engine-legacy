  <library_effects>
    <effect id="lambert1-fx">
      <profile_COMMON>
        <newparam sid="file1-surface">
          <surface type="2D">
            <init_from>file1</init_from>
          </surface>
        </newparam>
        <newparam sid="file1-sampler">
          <sampler2D>
            <source>file1-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color>0 0 0 1</color>
            </emission>
            <ambient>
              <color>0 0 0 1</color>
            </ambient>
            <diffuse>
