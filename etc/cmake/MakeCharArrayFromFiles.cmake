FUNCTION(MAKE_CHAR_ARRAY_FROM_FILES GENERATED_FILES)
  IF (NOT ARGN)
    MESSAGE(SEND_ERROR "MAKE_CHAR_ARRAY_FROM_FILES called without any source files")
    RETURN()
  ENDIF(NOT ARGN)

  SET(${GENERATED_FILES})

  SET(LUA_INTERPRETER ${EXECUTABLE_OUTPUT_PATH}/lua)

  INCLUDE_DIRECTORIES(${CMAKE_CURRENT_BINARY_DIR})

  FOREACH(FILE ${ARGN})
    GET_FILENAME_COMPONENT(FILE_PATH ${FILE} ABSOLUTE)
    GET_FILENAME_COMPONENT(FILE_NAME ${FILE} NAME_WE)

    SET(DUMP_FILE "${CMAKE_CURRENT_BINARY_DIR}/${FILE_NAME}.dump.h")

    LIST(APPEND ${GENERATED_FILES} ${DUMP_FILE})

    ADD_CUSTOM_COMMAND(
      OUTPUT ${DUMP_FILE}
      COMMAND ${LUA_INTERPRETER}
      ARGS ${ENGINE_SCRIPT_DIR}/make_char_array_from_file.lua ${FILE_PATH} ${DUMP_FILE}
      DEPENDS ${FILE_PATH} luai
      COMMENT "Running file to char array converter on ${FILE}"
      VERBATIM)

    SET_SOURCE_FILES_PROPERTIES(${DUMP_FILE} PROPERTIES GENERATED TRUE)
  ENDFOREACH()

  SET(${GENERATED_FILES} ${${GENERATED_FILES}} PARENT_SCOPE)
ENDFUNCTION(MAKE_CHAR_ARRAY_FROM_FILES)
