
FUNCTION (MAKE_TESTS_FROM_SOURCES VAR)
  FILE (GLOB TESTS *.cpp)

  FOREACH (TEST_SOURCE ${TESTS})
    GET_FILENAME_COMPONENT (TEST_NAME ${TEST_SOURCE} NAME_WE)
    ADD_EXECUTABLE (${TEST_NAME} ${TEST_SOURCE})
    TARGET_LINK_LIBRARIES (${TEST_NAME} ${ARGV})
    ADD_TEST (${TEST_NAME} ${EXECUTABLE_OUTPUT_PATH}/${TEST_NAME} ${CMAKE_CURRENT_SOURCE_DIR})
  ENDFOREACH()
ENDFUNCTION()
