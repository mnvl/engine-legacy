FUNCTION(BIN2C GENERATED_FILES)
  IF (NOT ARGN)
    MESSAGE(SEND_ERROR "BIN2C called without any source files")
    RETURN()
  ENDIF(NOT ARGN)

  SET(${GENERATED_FILES})

  GET_TARGET_PROPERTY(LUA_INTERPRETER luai LOCATION)

  INCLUDE_DIRECTORIES(${CMAKE_CURRENT_BINARY_DIR})

  FOREACH(SOURCE ${ARGN})
    GET_FILENAME_COMPONENT(SOURCE_PATH ${SOURCE} ABSOLUTE)
    GET_FILENAME_COMPONENT(SOURCE_NAME ${SOURCE} NAME)

    SET(DUMP_FILE "${CMAKE_CURRENT_BINARY_DIR}/${SOURCE_NAME}.h")

    LIST(APPEND ${GENERATED_FILES} ${DUMP_FILE})

    ADD_CUSTOM_COMMAND(
      OUTPUT ${DUMP_FILE}
      COMMAND ${LUA_INTERPRETER}
      ARGS ${ENGINE_LUA_DIR}/util/bin2c.lua ${SOURCE_PATH} ${DUMP_FILE}
      DEPENDS ${SOURCE_PATH} luai
      COMMENT "Running bin2c on ${SOURCE}"
      VERBATIM)

    SET_SOURCE_FILES_PROPERTIES(${DUMP_FILE} PROPERTIES GENERATED TRUE)
  ENDFOREACH()

  SET(${GENERATED_FILES} ${${GENERATED_FILES}} PARENT_SCOPE)
ENDFUNCTION(BIN2C)
